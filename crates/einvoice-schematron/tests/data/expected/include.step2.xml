<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://purl.oclc.org/dsdl/schematron" defaultPhase="main" queryBinding="xslt2">
  <ns prefix="a" uri="urn:example:a"/>
  <phase id="main">
    <active pattern="Included"/>
    <active pattern="Local"/>
  </phase>
  <phase id="other">
    <active pattern="Local"/>
  </phase>
  <pattern id="Included">
  <rule context="a:Line">
    <assert id="I-1" test="a:Id">A line has an identifier.</assert>
  </rule>
</pattern>
  <pattern id="Local">
    <rule context="a:Order">
      <assert id="E-1" test="a:Id">An order has an identifier (from another file).</assert>
      <assert id="L-1" test="a:Date">An order has a date.</assert>
    </rule>
  </pattern>
  <pattern id="Unused">
    <rule context="a:Never">
      <report id="U-1" test="true()">Never reported in phase main.</report>
    </rule>
  </pattern>
</schema>