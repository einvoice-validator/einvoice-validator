<?xml version="1.0" encoding="UTF-8"?>
<!-- A default namespace node on an element in no namespace. -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/"><out><a><xsl:namespace name="" select="'urn:d'"/></a></out></xsl:template>
</xsl:stylesheet>
